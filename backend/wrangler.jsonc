{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gulabi-gali-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },
  // Replace the id with the output of: wrangler kv namespace create CITY
  "kv_namespaces": [{ "binding": "CITY", "id": "e7b324909cfc47b883bcbf65c30b678b" }],
  // Replace the id with the output of: wrangler d1 create gulabi-gali
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gulabi-gali",
      "database_id": "0bb72cff-094b-4759-b043-7ba817f1cc94",
      "migrations_dir": "migrations",
    },
  ],
  // Needs the manishbisht.me zone on Cloudflare; see docs/deployment.md for the workers.dev fallback.
  // Off on purpose: every request must come through the custom domain, where Cloudflare sets CF-Connecting-IP
  // (src/limits.ts counts an address-less request under one shared key). docs/deployment.md covers the fallback.
  "workers_dev": false,
  "routes": [{ "pattern": "api.gulabi-gali.manishbisht.me", "custom_domain": true }],
  "durable_objects": {
    "bindings": [
      { "name": "DISTRICT", "class_name": "DistrictDO" },
      { "name": "INBOX", "class_name": "InboxDO" },
      // One object for the whole city: the cap on residents and the line for room (src/gate.ts).
      { "name": "GATE", "class_name": "GateDO" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DistrictDO"] },
    { "tag": "v2", "new_sqlite_classes": ["InboxDO"] },
    { "tag": "v3", "new_sqlite_classes": ["GateDO"] },
  ],
  // Per-address brakes (see src/limits.ts; loopback never counts). Periods may only be 10 or 60 seconds, so the
  // hourly invite limit is counted in D1 instead. `namespace_id` is any integer unique within the account.
  "ratelimits": [
    // Opening live and inbox sockets: generous, since every reconnect is one.
    { "name": "SOCKETS_LIMITER", "namespace_id": "51001", "simple": { "limit": 120, "period": 60 } },
    // Account bootstrap: Clerk does the sign-in; this is the first /api/me that creates an account, and dev login.
    { "name": "SIGNIN_LIMITER", "namespace_id": "51002", "simple": { "limit": 20, "period": 60 } },
    // Every API write (POST, PUT, DELETE): a flood ceiling, not a quota. Carriers put many people behind one
    // address, and junk posts before sign-in count too, so it is roomy; per-account limits do the fine work.
    { "name": "WRITES_LIMITER", "namespace_id": "51003", "simple": { "limit": 300, "period": 60 } },
    // Error reports from pages (POST /api/errors, no sign-in): checked before any D1 write, so a flood costs
    // nothing; the D1 per-address count and the city-wide hourly ceiling come after it (src/errors.ts).
    { "name": "ERRORS_LIMITER", "namespace_id": "51004", "simple": { "limit": 20, "period": 60 } },
    // The welcome screen's count (GET /api/count, no sign-in): a page asks every 30 s, and carriers put many
    // people behind one address, so it is roomy; the edge cache answers most of them anyway (src/count.ts).
    { "name": "COUNT_LIMITER", "namespace_id": "51005", "simple": { "limit": 120, "period": 60 } },
  ],
  "triggers": { "crons": ["*/15 * * * *"] },
  // The most live sockets one district holds (ghosts included), and from one address or IPv6 /64; and the most
  // residents seen at once across the city (anyone more waits in line as a ghost, see src/gate.ts).
  "vars": {
    "API_ORIGIN": "https://api.gulabi-gali.manishbisht.me",
    "MAX_DISTRICT_SOCKETS": "400",
    "MAX_IP_SOCKETS": "24",
    "MAX_LIVE": "300",
  },
}
