{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gulabi-gali-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },
  // Replace the id with the output of: wrangler kv namespace create CITY
  "kv_namespaces": [{ "binding": "CITY", "id": "REPLACE_WITH_CITY_KV_ID" }],
  // Replace the id with the output of: wrangler d1 create gulabi-gali
  "d1_databases": [
    { "binding": "DB", "database_name": "gulabi-gali", "database_id": "REPLACE_WITH_D1_ID", "migrations_dir": "migrations" },
  ],
  // Needs the manishbisht.me zone on Cloudflare; see docs/deployment.md for the workers.dev fallback.
  "routes": [{ "pattern": "api.gulabi-gali.manishbisht.me", "custom_domain": true }],
  "durable_objects": {
    "bindings": [
      { "name": "DISTRICT", "class_name": "DistrictDO" },
      { "name": "INBOX", "class_name": "InboxDO" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DistrictDO"] },
    { "tag": "v2", "new_sqlite_classes": ["InboxDO"] },
  ],
  "triggers": { "crons": ["*/15 * * * *"] },
  // The most live sockets one district holds, ghosts included (see DistrictDO).
  "vars": { "MAX_DISTRICT_SOCKETS": "400" },
}
